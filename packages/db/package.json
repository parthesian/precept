{
  "name": "@precept/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @precept/db\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/load.ts",
    "db:reset": "tsx src/reset.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@precept/shared": "file:../shared",
    "drizzle-orm": "^0.39",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@types/node": "^22",
    "drizzle-kit": "^0.30",
    "tsx": "^4",
    "typescript": "^5.5",
    "vitest": "^3",
    "wrangler": "4.119.0"
  }
}
