{
  "name": "@precept/importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "import": "tsx src/cli.ts",
    "bootstrap": "tsx src/cli.ts --bootstrap --top=5000",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @precept/importer\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@precept/db": "file:../db",
    "@precept/shared": "file:../shared",
    "dotenv": "^16",
    "drizzle-orm": "^0.39",
    "ulid": "^2.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.5",
    "vitest": "^3"
  }
}
