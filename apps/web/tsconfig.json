{
  "include": [
    "app/**/*",
    "workers/**/*",
    "src/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".react-router",
    "dist"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "types": [
      "vite/client",
      "@cloudflare/workers-types"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "verbatimModuleSyntax": false
  }
}
