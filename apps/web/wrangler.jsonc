{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "precept",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "TRUSTED_APPROVALS_THRESHOLD": "10",
    "RATE_LIMIT_SUGGESTIONS_PER_HOUR": "60",
    "RATE_LIMIT_VOTES_PER_HOUR": "120",
    "RATE_LIMIT_TMDB_SEARCH_PER_HOUR": "120",
    "RATE_LIMIT_TMDB_IMPORT_PER_HOUR": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "precept",
      "database_id": "9fffd6c3-ae92-4aea-8f06-32e27cb31f94",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "76e091f78ee0422b8afbf5eb2d19cbf6",
      "preview_id": "599df64a2b1f462099d870bbb6df34b7"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TMDB_IMPORT_QUEUE",
        "queue": "tmdb-import"
      }
    ],
    "consumers": [
      {
        "queue": "tmdb-import",
        "max_batch_size": 1,
        "max_retries": 3
      }
    ]
  }
}
