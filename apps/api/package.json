{
  "name": "@precept/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @precept/api\"",
    "test": "vitest run",
    "admin:create": "tsx src/cli/admin-create.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13",
    "@precept/db": "file:../../packages/db",
    "@precept/importer": "file:../../packages/importer",
    "@precept/shared": "file:../../packages/shared",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16",
    "drizzle-orm": "^0.39",
    "hono": "^4.6",
    "ulid": "^2.3",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.5",
    "vitest": "^3"
  }
}
