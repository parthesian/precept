# Required — Postgres connection string
DATABASE_URL=postgres://precept:precept@localhost:5432/precept

# Required — session signing secret (any long random string)
AUTH_SECRET=dev-change-me-to-a-long-random-string

# API
API_PORT=8787
API_ORIGIN=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Trusted-role auto-approve threshold (approved suggestions needed)
TRUSTED_APPROVALS_THRESHOLD=10

# Rate limits
RATE_LIMIT_SUGGESTIONS_PER_HOUR=60
RATE_LIMIT_VOTES_PER_HOUR=120

# Web
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional — TMDB importer (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Optional — Milestone 8 AI proposals only
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# ENABLE_PYTHON_VISION_SERVICE=false
# VISION_SERVICE_URL=http://localhost:8010
