# ── Cloudflare Workers path (preferred) ──────────────────────────────
# Runtime secrets for `wrangler dev` / Vite CF plugin live in `.dev.vars`
# (see `.dev.vars.example`). Do not put Worker secrets only here.
#
#   AUTH_SECRET=...
#   TMDB_API_KEY=...
#
# Bindings (D1 DB, KV RATE_LIMIT, Queue TMDB_IMPORT_QUEUE) are declared
# in wrangler.jsonc — there is no DATABASE_URL for the Worker apps.

# ── Optional Node CLIs (importer / transitional scripts) ─────────────
# Kept for local Node tooling until fully on Wrangler D1 helpers.
AUTH_SECRET=dev-change-me-to-a-long-random-string
TMDB_API_KEY=

# Trusted-role auto-approve threshold (approved suggestions needed)
TRUSTED_APPROVALS_THRESHOLD=10

# Rate limits (also set as wrangler vars)
RATE_LIMIT_SUGGESTIONS_PER_HOUR=60
RATE_LIMIT_VOTES_PER_HOUR=120
# RATE_LIMIT_TMDB_SEARCH_PER_HOUR=120
# RATE_LIMIT_TMDB_IMPORT_PER_HOUR=30

# ── Deprecated (Postgres / split-origin Next path) ───────────────────
# DATABASE_URL=postgres://precept:precept@localhost:5432/precept
# API_PORT=8787
# API_ORIGIN=http://localhost:8787
# WEB_ORIGIN=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional — Milestone 8 AI proposals only
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# ENABLE_PYTHON_VISION_SERVICE=false
# VISION_SERVICE_URL=http://localhost:8010
